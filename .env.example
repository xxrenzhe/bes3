# Copy this file to .env for local development. The .env file is gitignored and must stay local only.
# Minimum keys for a local smoke test:
# - JWT_SECRET
# - ENCRYPTION_KEY
# - DEFAULT_ADMIN_PASSWORD
# Optional keys for feature testing:
# - GEMINI_API_KEY
# - PARTNERBOOST_AMAZON_TOKEN
# - PARTNERBOOST_DTC_TOKEN
#
# Quick start:
# cp .env.example .env
# npm run ops:check-env:local
# npm run db:init
# npm run dev
#
# Local development runtime
NODE_ENV=development
PORT=3000
HOSTNAME=0.0.0.0
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production example: https://bes3.com
BES3_ALLOWED_HOSTS=bes3.com,www.bes3.com,localhost,localhost:3000,127.0.0.1,127.0.0.1:3000
# Maintain this in your local .env and never commit it.
JWT_SECRET=
# Encrypts sensitive values stored in system_settings. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Default admin bootstrap
DEFAULT_ADMIN_USERNAME=autobes3
DEFAULT_ADMIN_EMAIL=admin@bes3.local
# Maintain this in your local .env and never commit it.
DEFAULT_ADMIN_PASSWORD=

# Database
# If DATABASE_URL is set, PostgreSQL is used.
# Otherwise the app falls back to SQLite at DATABASE_PATH.
DATABASE_URL=
DATABASE_PATH=./data/bes3.db

# Media storage
# local: persist to ./storage/media during development
# s3: persist to object storage; MEDIA_PUBLIC_BASE_URL is optional when the endpoint itself can serve public objects
MEDIA_DRIVER=local
MEDIA_LOCAL_ROOT=storage/media
MEDIA_PUBLIC_BASE_URL=

# S3 / MinIO / R2 compatible object storage
# S3_ENDPOINT may be a full URL or a bare host like objectstorageapi.sg-members-1.clawcloudrun.com
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# PartnerBoost affiliate sync
PARTNERBOOST_AMAZON_BASE_URL=https://app.partnerboost.com
PARTNERBOOST_AMAZON_TOKEN=
PARTNERBOOST_DTC_BASE_URL=https://app.partnerboost.com
PARTNERBOOST_DTC_TOKEN=

# Gemini AI generation
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Scraping / publishing
PLAYWRIGHT_HEADLESS=true
PINGOMATIC_ENABLED=false

# SEO automation preview is safe by default.
# Set SEO_AUTOMATION_APPLY=true only for scheduled jobs that may update taxonomy state.
SEO_AUTOMATION_APPLY=false
SEO_AUTOMATION_PUSH_INDEX=false
SEO_AUTOMATION_LIMIT=200
SEO_AUTOMATION_SIGNAL_FILE=
SEO_AUTOMATION_SIGNAL_SOURCE=ga4

# Background pipeline worker
PIPELINE_WORKER_ENABLED=true
PIPELINE_WORKER_ID=
PIPELINE_WORKER_POLL_MS=2500
PIPELINE_WORKER_CONCURRENCY=1
