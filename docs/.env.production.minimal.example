# Bes3 最小生产环境变量示例
# 适用基线：Cloudflare + 单容器 + PostgreSQL
# 用法：
#   cp docs/.env.production.minimal.example /srv/bes3/.env.production
# 然后把所有占位值替换成真实值。
# 注意：
# 1. 这只是“站点可稳定启动”的最小配置，不包含对象存储、联盟同步、AI、代理、Google Indexing 等增强能力
# 2. 不要把真实 .env.production 提交到 Git
# 3. 媒体/S3、AI、联盟同步、代理、SEO 等运行配置优先在 /settings 页面维护；敏感值会加密存入 system_settings
# 4. ENCRYPTION_KEY 不能放在 /settings；它用于解密 system_settings 中的敏感配置，必须由环境变量提供

NODE_ENV=production
PORT=80
HOSTNAME=0.0.0.0

NEXT_PUBLIC_APP_URL=https://www.bes3.com

# 生成方法：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
ENCRYPTION_KEY=replace-with-a-random-32-byte-hex-encryption-key
DEFAULT_ADMIN_USERNAME=autobes3
DEFAULT_ADMIN_EMAIL=admin@bes3.com
DEFAULT_ADMIN_PASSWORD=replace-with-a-random-admin-password-before-first-run

DATABASE_URL=postgres://user:password@db.example.com:5432/bes3

# 最小启动先使用本地媒体目录；生产对象存储请登录后台 /settings 后切到 media.driver=s3。
# S3_ENDPOINT 支持裸域名或完整 URL，例如 objectstorageapi.sg-members-1.clawcloudrun.com。
MEDIA_DRIVER=local
MEDIA_LOCAL_ROOT=storage/media
